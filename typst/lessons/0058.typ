  [Длина], [2–5 минут], [больше 6 минут — режьте на два дня],
  [Говорящие], [1–2 человека], [ток-шоу с 4 голосами и смехом],
  [Тема], [вы уже знаете о ней что-то на русском], [полностью незнакомая область],
  [Форма], [монолог, интервью, репортаж], [телефонный эфир, музыка поверх речи],
  [Опора], [есть описание эпизода или текст на странице], [только заголовок],
  [Проверка 30 с], [на первой полуминуте поняли тему], [не поняли ни одной фразы — другой клип],
)

