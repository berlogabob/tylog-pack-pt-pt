)

=== 3. #pt[Futuro simples]

Инфинитив целиком + окончания #pt[-ei, -ás, -á, -emos, -ão]. Одинаково для -ar/-er/-ir.


#table(columns: 7,
  table.header([Кто], [falar], [ter], [ir], [fazer → far-], [dizer → dir-], [trazer → trar-]),
  [eu], [falarei], [terei], [irei], [farei], [direi], [trarei],
  [tu], [falarás], [terás], [irás], [farás], [dirás], [trarás],
  [ele / você], [falará], [terá], [irá], [fará], [dirá], [trará],
  [nós], [falaremos], [teremos], [iremos], [faremos], [diremos], [traremos],
  [eles / vocês], [falarão], [terão], [irão], [farão], [dirão], [trarão],
)

Так же: #pt[ser → serei, poder → poderei, haver → haverá] («будет» о существовании: #pt[Não haverá aula na sexta.]). Ударение всегда на окончании: #pt[falarEI, farÁ, terEMOS].


=== 4. #pt[Ir + infinitivo] или #pt[futuro simples]?

#table(columns: 3,
  table.header([Ситуация], [Форма], [Пример]),
  [Разговор, план, ближайшее намерение (основной вариант в речи PT-PT)], [ir + infinitivo], [Vou falar com o coordenador. Não vamos usar o Unity.],
  [Письменный и официальный стиль: email, программа курса, объявление], [futuro simples], [A entrega será no dia 19. Os alunos terão três semanas.],
  [Обещание, прогноз, главная часть после #pt[se / quando]], [futuro simples], [Se tudo correr bem, tocaremos em novembro. Quando souber, direi.],
  [Предположение о настоящем («интересно, …», «наверное»)], [futuro simples], [Será que a sala está livre? Onde estará o Rui?],
)

#strong[Три ловушки.] 1) #pt[\*vou ir] не говорят: #pt[Vou ao IADE amanhã] или #pt[Irei ao IADE]. 2) «Через две недели» — #pt[daqui a duas semanas], а не #pt[\*em duas semanas] (это «за две недели»). 3) Не смешивать в одной фразе: #pt[Vou entregar o plano e falarei…] звучит странно; в речи держитесь #pt[ir + infinitivo], в письме — #pt[futuro simples].


