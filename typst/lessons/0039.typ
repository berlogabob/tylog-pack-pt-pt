=== 3. Императив: три формы, которые нужны каждый день

#table(columns: 5,
  table.header([Инфинитив], [#pt[tu] (+)], [#pt[tu] (−)], [#pt[o senhor / você] (±)], [#pt[vocês] (±)]),
  [falar], [fala], [não fales], [(não) fale], [(não) falem],
  [comer], [come], [não comas], [(não) coma], [(não) comam],
  [abrir], [abre], [não abras], [(não) abra], [(não) abram],
  [fazer], [faz], [não faças], [(não) faça], [(não) façam],
  [dizer], [diz], [não digas], [(não) diga], [(não) digam],
  [trazer], [traz], [não tragas], [(não) traga], [(não) tragam],
  [pôr], [põe], [não ponhas], [(não) ponha], [(não) ponham],
  [ter], [tem], [não tenhas], [(não) tenha], [(não) tenham],
  [vir], [vem], [não venhas], [(não) venha], [(não) venham],
  [ir], [vai], [não vás], [(não) vá], [(não) vão],
  [ser], [sê], [não sejas], [(não) seja], [(não) sejam],
  [estar], [está], [não estejas], [(não) esteja], [(não) estejam],
)

#strong[Правило 1 — #pt[tu] утвердительно:] берём форму #pt[ele/ela] настоящего времени: #pt[ele fala → fala! ele come → come! ele faz → faz! ele diz → diz!] Исключение: #pt[sê] (ser).


#strong[Правило 2 — всё остальное = presente do conjuntivo:] глаголы на #pt[-ar] получают #pt[-e / -es / -em], глаголы на #pt[-er/-ir] получают #pt[-a / -as / -am]. Основа — от формы #pt[eu]: #pt[faço → faça, digo → diga, trago → traga, ponho → ponha, tenho → tenha, venho → venha]. Орфография: #pt[ficar → fique, pagar → pague, começar → comece, tocar → toque].


#strong[Правило 3 — местоимение:] утвердительный императив → энклиза (#pt[Diz-me. Dá-lhe. Envie-me. Sente-se.]); отрицательный → проклиза (#pt[Não me digas. Não lhe dês. Não se esqueça. Não te preocupes.]). Возвратные: #pt[senta-te / sente-se; levanta-te / levante-se; não te sentes / não se sente].


#strong[Частые готовые формы:] #pt[Desculpe. Diga. Olhe. Veja. Ouça. Espere. Repita, por favor. Fale mais devagar. Deixe-me ver. Siga em frente. Entre. Sente-se. Tenha um bom dia. Cuidado!] — и с #pt[tu]: #pt[Olha. Ouve. Espera. Anda cá. Vem comigo. Deixa-me ver. Não te preocupes. Não faças isso.]


=== 4. Лестница вежливости

#table(columns: 3,
  table.header([Уровень], [#pt[tu]], [#pt[o senhor / a senhora]]),
  [прямое указание], [Fecha a janela.], [Feche a janela.],
  [#h(0pt)+ por favor / se faz favor], [Fecha a janela, se faz favor.], [Feche a janela, por favor.],
  [вопрос-просьба], [Podes fechar a janela?], [Pode fechar a janela?],
  [условная форма], [Podias fechar a janela?], [Podia fechar a janela?],
  [importar-se de], [Importas-te de fechar a janela?], [Importa-se de fechar a janela?],
  [очень мягко], [Era possível fechares a janela?], [Era possível fechar a janela? / Será que podia fechar a janela?],
)

В PT-PT #pt[se faz favor] и #pt[por favor] равнозначны; первое чаще в речи. #pt[Podia] — не прошедшее, а вежливый настоящий момент. #strong[Ответы:] #pt[Com certeza. Claro. Com todo o gosto. Já está. / Lamento, mas não é possível. Infelizmente não posso. Agora não dá, mas logo à tarde sim.]


